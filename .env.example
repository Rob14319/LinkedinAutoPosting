# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# LinkedIn API Credentials
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_PERSON_URN=urn:li:person:your_person_id_here

# Premium Email Settings (Resend)
RESEND_API_KEY=your_resend_api_key_here
USER_EMAIL=your_email@example.com

# Portal URL (e.g., https://your-portal.vercel.app)
PORTAL_URL=http://localhost:5173

# GitHub Integration (Needed for the Review Portal to trigger actions)
GITHUB_TOKEN=your_github_pat_here
REPO_OWNER=your_github_username_here
REPO_NAME=your_repo_name_here

# Twilio Configuration (WhatsApp / SMS Notifications)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=whatsapp:+14155238886  # or regular Twilio number
TWILIO_TO_NUMBER=whatsapp:+919876543210   # or your personal number
